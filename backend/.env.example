# Server
PORT=5000
NODE_ENV=development

# MongoDB (legacy/runtime paths that still use Mongoose models)
MONGODB_URI=mongodb://127.0.0.1:27017/campusai

# Supabase PostgreSQL / Prisma
# Use the Supabase connection string from Project Settings > Database.
# For connection pooling, use the pooler/transaction URL as DATABASE_URL when supported by your Prisma/runtime setup.
# For migrations, Supabase may require a direct (non-pooler) connection URL; if you add it, keep it in environment variables and do not commit secrets.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require

# Auth
JWT_SECRET=replace-with-a-strong-secret-at-least-32-characters
JWT_EXPIRES_IN=7d

# Optional integrations
ML_SERVICE_URL=http://localhost:8000
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
